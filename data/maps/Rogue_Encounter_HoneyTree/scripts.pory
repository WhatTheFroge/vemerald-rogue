const FLAG_HIDE_WILD_MON = FLAG_TEMP_1

mapscripts Rogue_Encounter_HoneyTree_MapScripts 
{
    MAP_SCRIPT_ON_LOAD: Rogue_Encounter_HoneyTree_OnLoad
}

script Rogue_Encounter_HoneyTree_OnLoad
{
    if(var(VAR_FOLLOW_MON_0) == SPECIES_NONE)
    {
        setflag(FLAG_HIDE_WILD_MON)
    }
}

script Rogue_Encounter_HoneyTree_ScatterPokeblock
{
    lock
	msgbox(format("It's a Honey Tree!\nThere are {POKEBLOCK} crumbs."))
    msgbox(format("You can scatter {POKEBLOCK} here."), MSGBOX_DEFAULT)
    release
}

script Rogue_Encounter_HoneyTree_TrainerTips
{
    lock
    msgbox(format("Trainer Tip!\nPokémon often visit Honey Trees."))
	msgbox(format("If you scatter {POKEBLOCK} near the Tree,\nthen next time, you will be able to\lfind Pokemon who enjoy that flavor."), MSGBOX_SIGN)
	
    release
}