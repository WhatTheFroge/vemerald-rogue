mapscripts Rogue_Interior_School_MapScripts {}


script Rogue_Interior_School_ShowSetRecommendation
{
    lock
    faceplayer
    
    msgbox(format("Oh hey, you look like a Trainer.\pHere, let me tell you how I would\nset up those Pokemon."))

    setvar(VAR_0x8004, 0)

    while(var(VAR_0x8004) != PARTY_SIZE)
    {
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        showmonpic(VAR_RESULT, 2, 2)
        playmoncry(VAR_RESULT, CRY_MODE_NORMAL)

        callnative(ScriptMenu_DisplayRecommendedMonSet)
        messageinstant("{DPAD_LEFTRIGHT} Cycle Party Pokémon\n{A_BUTTON} {B_BUTTON} Exit")
        waitstate
        hidemonpic
    }

    msgbox(format("If you need any more help, just ask!"))

    release
}

script Rogue_Interior_School_TalkRunningKid0
{
    lockall
    faceplayer

    msgbox(format("I'm double tapping B to run super fast!\nYou can escape from wild Pokemon faster too! So fast!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningKid1
{
    lockall
    faceplayer

    msgbox(format("Get back here!\nB B B B B B!"))

    releaseall
}

script Rogue_Interior_School_TalkRunningStatsHint
{
    lockall
    faceplayer

    msgbox(format("Arrgghhh!"))
	msgbox(format("EV training is so much harder now!\nI can't grind against wild Pokemon.\lNow, only trainer battles grant EVs."))
	msgbox(format("Pokemon gain EVs based on nature.\nSo natures became much more important."))
	msgbox(format("But luckily, the Stat Summary can show\na Pokemon's EVs and IVs at any time!"))

    releaseall
}

script Rogue_Interior_School_TalkPokeblock
{
    lockall
    faceplayer

    msgbox(format("My Pokémon love Pokeblock!"))
    msgbox(format("Did you know that you can use\nPokeblock whilst on a route?"))
    msgbox(format("This allows you to attract\nspecific types of Pokemon."))
    releaseall
}

script Rogue_Interior_School_TalkTeacher
{
    lockall
    faceplayer

    msgbox(format("Welcome!"))
	msgbox(format("I've been teaching my students\nall about Adventuring."))
	
	msgbox(format("They would gladly share their\nknowledge with you."))
	msgbox(format("Just talk to them!"))
	
    releaseall
}

script Rogue_Interior_School_TalkRouteHint
{
    lockall
    faceplayer


	msgbox(format("I've been studying a lot about the\nencounters you can find on Adventures."))
	msgbox(format("I don't know everything, but I can still\ntell you what I've learnt so far!"))
	msgbox(format("What would you like to know?"))

    setvar(VAR_RESULT, 0)

    while(var(VAR_RESULT) != MULTI_B_PRESSED)
    {
        begindynamicmultichoice
        appenddynamicmultichoice("Route Difficulty", 0)
        appenddynamicmultichoice("Route Types", 1)
        appenddynamicmultichoice("Trained Pokémon Habitats", 2)
        appenddynamicmultichoice("Honey Trees", 3)

        message(format("Is there anything I can tell you about?"))
        waitmessage
        enddynamicmultichoice(20, 2, 5, TRUE)
        
        switch(var(VAR_RESULT))
        {
            case 0:
                msgbox(format("Listen up!\nEvery route has a difficulty and a type.\lThe difficulties are calm, average, and tough."))
				msgbox(format("Calm routes have the highest variety\nof wild Pokemon, but the least Items\land Trainers."))
				msgbox(format("Tough routes have few wild Pokemon,\nbut more Items and Trainers.\lThe trainers on tough routes are also much more powerful!"))
				msgbox(format("Average routes have a balance of wild\nPokemon, items, and trainers.\lAverage is usually a safe choice."))
					
            case 1:
                msgbox(format("Listen up!\nEvery route has a difficulty and a type."))
				msgbox(format("The first wild Pokemon on a route will\nalways match the type hint."))
				
				
            case 2:
                msgbox(format("Hmm..\nThese encounters are very odd."))
				msgbox(format("The Pokemon seem to already have\nbeen trained to battle."))
				msgbox(format("They have optimized natures, abilities,\nand moves, plus one perfect IV."))
				msgbox(format("These strong Pokemon live alone.\nYou can't really know what you'll find."))
				msgbox(format("It could be a Charizard!\nOr a Caterpie..."))
				msgbox(format("These encounters can be really fun\nfor people who like to gamble!"))
				
            case 3:
                msgbox(format("Wild Pokemon like to go to Honey\nTrees to eat and relax."))
                msgbox(format("But if you have Pokeblock, these\ntrees can become much more useful."))
                msgbox(format("You could scatter some Grass and\nPoison Pokeblock to attract Bulbasaur."))
                msgbox(format("Then, the next time you come across\na Honey Tree, you would be guaranteed\lto get a Bulbasaur!\lOr an Oddish or a Bellsprout..."))
                msgbox(format("The efficiency really depends on how\nunique the type is of the Pokemon\lyou want to catch.."))
				
            case MULTI_B_PRESSED:
                msgbox(format("Oh, OK…\pI've got plenty more to share,\nif you wanna know!"))
        }
    }

    releaseall
}